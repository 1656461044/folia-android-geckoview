# 复制本文件为 keystore.properties 后填入你自己的签名信息。
#
# 不要提交 keystore.properties 和 .keystore 文件本身（已在 .gitignore 里排除）。
# 仓库里不带任何私钥——想装到设备上自己生成一个自签名证书即可：
#
#   keytool -genkeypair -v -keystore folia-gecko.keystore \
#     -alias folia -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass 你的口令 -keypass 你的口令 \
#     -dname "CN=Your Name, OU=Dev, O=Personal, L=CN, ST=CN, C=CN"
#
# 没有 keystore.properties 时构建仍能进行，只是产出未签名的 APK
# （build.gradle 里有 hasKeystore 判断）。

storeFile=folia-gecko.keystore
storePassword=换成你的口令
keyAlias=folia
keyPassword=换成你的口令
